# Copy to .env.local (local development) or add in Vercel → Project → Settings → Environment Variables.
# Both values are public by design (they ship to the browser). Access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Never add the service_role / secret key to this app. It belongs only in n8n.

# Optional: lets the team reply to Messenger / Instagram customers from the dashboard.
# Server-only (no NEXT_PUBLIC_ prefix): the browser never sees them.
# URL = the "Staff Reply" n8n workflow's Production URL; the key and header name must match
# its Header Auth credential in n8n. Pick a long random key.
N8N_STAFF_REPLY_URL=
N8N_DASHBOARD_KEY=
N8N_DASHBOARD_KEY_HEADER=X-Dashboard-Key
